{
  "name": "libwa.js",
  "version": "0.4.0",
  "description": "TypeScript-first, interaction-driven WhatsApp bot library — discord.js-style DX on a pluggable backend (Baileys included).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "docs", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gustavo10Destroyer/libwa.js.git"
  },
  "homepage": "https://gustavo10destroyer.github.io/libwa.js-docs",
  "bugs": {
    "url": "https://github.com/Gustavo10Destroyer/libwa.js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:exports": "node scripts/check-exports.mjs",
    "verify": "npm run typecheck && npm run test && npm run lint && npm run build && npm run check:exports",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-bot",
    "whatsapp-api",
    "whatsapp-web",
    "bot",
    "chatbot",
    "bot-framework",
    "baileys",
    "nodejs",
    "typescript",
    "interactions",
    "middleware",
    "commands",
    "sessions",
    "sqlite",
    "multi-account",
    "qr-code",
    "pairing-code"
  ],
  "author": "Gustavo10Destroyer (https://github.com/Gustavo10Destroyer)",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.0.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
